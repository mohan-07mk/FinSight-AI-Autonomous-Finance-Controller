# FinSight AI — Git Ignore Rules

# Environment secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Node
node_modules/
dist/
build/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend Uploads (Ignore uploaded CSV/XLSX files, preserve directory)
backend/uploads/*
!backend/uploads/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
